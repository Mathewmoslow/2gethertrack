rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Trainer private workspace (roster, expenses, settings)
    match /users/{trainerUid}/{collection}/{docId} {
      allow read, write: if request.auth.uid == trainerUid;
    }

    // Client claiming an invite writes their UID onto a roster entry.
    // Happens AFTER createUserWithEmailAndPassword so auth is set by then.
    match /users/{trainerUid}/clients/{rosterId} {
      allow update: if request.auth != null
                    && resource.data.clientUid == null
                    && request.resource.data.clientUid == request.auth.uid;
    }

    // Invite codes (top-level).
    // get is unauthenticated so signup flow can look up the code BEFORE
    // creating the user account. list is denied (default), so codes can't
    // be enumerated; attacker must already know the 6-char ID.
    match /inviteCodes/{code} {
      allow get: if true;
      allow create: if request.auth.uid == request.resource.data.trainerUid;
      allow update: if request.auth != null
                    && resource.data.used == false
                    && request.resource.data.used == true
                    && request.resource.data.clientUid == request.auth.uid;
      allow delete: if request.auth.uid == resource.data.trainerUid;
    }

    // Programs - split read rules per query path
    match /programs/{programId} {
      allow read: if request.auth.uid == resource.data.trainerUid;
      allow read: if request.auth.uid == resource.data.clientUid;
      allow create: if request.auth.uid == request.resource.data.trainerUid;
      allow update, delete: if request.auth.uid == resource.data.trainerUid;
    }

    // Workout logs - split read rules per query path
    match /clientLogs/{logId} {
      allow read: if request.auth.uid == resource.data.trainerUid;
      allow read: if request.auth.uid == resource.data.clientUid;
      allow create: if request.auth.uid == request.resource.data.clientUid;
      allow update, delete: if request.auth.uid == resource.data.clientUid;
    }
  }
}
